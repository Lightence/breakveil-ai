{
  "name": "breakveil-ai",
  "private": true,
  "version": "0.4.2",
  "description": "A private desktop workspace for job discovery, application preparation and progress tracking.",
  "author": "BreakVeil",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Lightence/breakveil-ai#readme",
  "bugs": {
    "url": "https://github.com/Lightence/breakveil-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lightence/breakveil-ai.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.cjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "wait-on http://localhost:5173 && electron .",
    "desktop": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "docx": "^9.7.1",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "gaxios": "7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "electron": "^43.1.1",
    "electron-builder": "26.15.7",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  },
  "main": "electron/main.cjs"
}
